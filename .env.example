# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./backend/data

# API keys mapped to roles: viewer < user < admin
ADMIN_API_KEY=dev-admin-key
USER_API_KEY=dev-user-key
VIEWER_API_KEY=dev-viewer-key

# ---------------------------------------------------------------------------
# Accounts and sessions (spec 004/005)
# ---------------------------------------------------------------------------
# Leave empty to keep SQLite in DATA_DIR. Set a Postgres URL (Supabase pooler
# recommended) for data that survives a Render redeploy:
# DATABASE_URL=postgresql://user:password@host:6543/dbname
DATABASE_URL=
# Operator account, created (or repaired) at every start. Keep out of git.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public registration is open by default; set a shared code to make it invite-only.
INVITE_CODE=
DEMO_LOGIN_ENABLED=true
SESSION_TTL_HOURS=168
# Secure cookies are automatic when ENVIRONMENT=production. Override only for a
# plain-HTTP production test.
# SESSION_SECURE=false
COOKIE_DOMAIN=
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=120
# Failed logins per normalised email before a temporary lock (unknown emails
# count too, so a 429 cannot reveal whether an account exists). A successful
# sign-in clears the counter; the lock lasts LOGIN_LOCK_MINUTES.
LOGIN_LOCK_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Supabase Auth (GoTrue) — the deployment identity provider.
# When SUPABASE_URL is set, AUTH_PROVIDER defaults to "supabase" and the local
# scrypt/session implementation is disabled. Keep these out of git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification: either HS256 secret (legacy projects) or JWKS endpoint.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_TIMEOUT_SECONDS=15
SUPABASE_SYNC_MAX_PAGES=10
# Where password-recovery emails land (the Next.js page that finishes the reset).
# Defaults to the Supabase project Site URL; set it to https://<web-host>/auth/reset
PASSWORD_RESET_REDIRECT_TO=

# Comma-separated origins. Use * only for local development.
CORS_ORIGINS=*

# Embeddings: "hashing" is the hosted default — instant, offline, no model
# download, no second service and no quota. BM25 does the lexical retrieval and
# the LLM (server key or BYOK) writes the cited answer. Optional alternatives:
# "gemini" (free API with quotas), "hf-api" (now paid) or
# "sentence-transformers" (local PyTorch, needs a larger plan).
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSION=384
# Optional model id for api-backed backends. Hashing ignores this value; Gemini
# defaults to gemini-embedding-001 and HF defaults to the IBM multilingual model.
# EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Ingestion batch size; hashing is instant, API-backed backends stay bounded.
EMBEDDING_BATCH_SIZE=64
# Google AI Studio key for EMBEDDING_BACKEND=gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional legacy backend: requires purchased HF credits or a PRO subscription.
HF_API_KEY=

# Chunking
CHUNK_SIZE=256
CHUNK_OVERLAP=40
# Drop dotted-leader table-of-contents chunks at ingestion (they steal section-title hits).
TOC_FILTER=true

# Retrieval
HYBRID_ALPHA=0.5
# Hashing mode: the bag-of-terms vector adds noise, so BM25 leads (0.0 = ignore it).
HASHING_VECTOR_WEIGHT=0.0
# Share of the question's IDF mass a chunk needs before it counts as evidence.
HASHING_MIN_COVERAGE=0.35
# How strongly the rerank stage rewards full-question coverage.
RERANK_COVERAGE_WEIGHT=0.5
# Following chunks pulled in when the question names a numbered section title.
RETRIEVAL_SECTION_EXPAND=3
DEFAULT_TOP_K=10
MAX_TOP_K=50
# Each completed document contributes up to this many hits before the global
# merge; the final answer still returns at most DEFAULT_TOP_K chunks.
PER_DOCUMENT_TOP_K=5
MAX_UPLOAD_MB=50
# Refuse (with a clear error) documents that would produce more chunks than this.
# 20000 accommodates large real PDFs with offline hashing; a runaway file would
# otherwise exhaust memory. Lower it only for very small instances.
MAX_CHUNKS_PER_DOCUMENT=20000

# Rebuild Arabic PDFs that pypdf extracts in mirrored (visual) order.
PDF_VISUAL_ORDER_REPAIR=true

# Optional vector database. Leave empty to use the local file-backed store.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_chunks

# Query cache (in memory). Repeated identical searches skip embedding and rerank.
# The cache is always invalidated by an upload or delete. 0 disables it.
SEARCH_CACHE_SIZE=128
SEARCH_CACHE_TTL_SECONDS=300

# Per-IP rate limits (requests per minute, in-memory token buckets).
# A scope set to 0 is unlimited. Auth runs first, so bad keys never consume quota.
RATE_LIMIT_ENABLED=true
# Behind Render, the last X-Forwarded-For hop is the visitor appended by the
# edge. Trusting the first hop would let a caller spoof a fresh bucket with one
# header edit. Set to false only when the API is exposed directly, without a proxy.
TRUST_PROXY_HEADERS=true
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# Checking a visitor's own key calls the provider, so it has its own bucket.
RATE_LIMIT_LLM_VERIFY_PER_MINUTE=10

# Optional OpenAI-compatible LLM. Leave empty for the deterministic fallback.
# The key is an admin privilege: other accounts must supply their own key below.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=45
LLM_MAX_TOKENS=512

# Bring-your-own-key: a visitor may send their own provider key per request.
# It is never stored, logged or traced. Turn the feature off with false: non-admin
# requests then answer with the free deterministic heuristics.
LLM_BYOK_ENABLED=true
# Optional strict chat gate. Keep false for free/offline deterministic answers
# and demo guests. true refuses keyless non-admin chat with the existing 402.
REQUIRE_CHAT_BYOK=false
# Exact-match allow-list for the visitor's X-LLM-Base-URL (blocks SSRF).
LLM_ALLOWED_BASE_URLS=https://api.openai.com/v1,https://openrouter.ai/api/v1,https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Frontend (server-side proxy)
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
# No API key here any more: the browser authenticates with the same-origin
# session cookie issued by /api/v1/auth/{demo,login,register}.

# Optional: talk to the backend directly from the browser instead of the proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_KEY=dev-admin-key

# ---------------------------------------------------------------------------
# Operator commands (run from the repository root with the SAME env as the API)
# ---------------------------------------------------------------------------
# py -3 scripts/verify_consistency.py                 # read-only, exit 1 if inconsistent
# py -3 scripts/verify_consistency.py --json
# py -3 scripts/reconcile_documents.py                # dry run: print the plan only
# py -3 scripts/reconcile_documents.py --apply
# py -3 scripts/reconcile_documents.py --apply --purge-orphans --json
